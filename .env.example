# ==============================================================================
# FinTrack: Environment Variables Example
# Salin berkas ini ke `.env` dan isi dengan konfigurasi proyek Supabase Anda.
# PENTING: Jangan masukkan Service Role Key ke berkas frontend ini!
#
# Aturan: variabel berawalan VITE_ ikut ter-bundle ke browser, jadi hanya boleh
# berisi nilai publik. Rahasia (API key penyedia AI, service role key, client
# secret Google) tidak boleh memakai awalan VITE_ dan hanya dibaca server di
# folder server/.
# ==============================================================================

# URL Project Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon / Publishable Key (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

