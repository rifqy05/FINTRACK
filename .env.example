# ==============================================================================
# FinTrack: Environment Variables Example
# Salin berkas ini ke `.env` dan isi dengan konfigurasi proyek Supabase Anda.
# PENTING: Jangan masukkan Service Role Key ke berkas frontend ini!
# ==============================================================================

# URL Project Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon / Publishable Key (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
