# ==============================================================================
# FinTrack: Environment Variables Example
# Salin berkas ini ke `.env` dan isi dengan konfigurasi proyek Supabase Anda.
# PENTING: Jangan masukkan Service Role Key ke berkas frontend ini!
#
# Aturan: variabel berawalan VITE_ ikut ter-bundle ke browser, jadi hanya boleh
# berisi nilai publik. Rahasia (API key penyedia AI, service role key, client
# secret Google) tidak boleh memakai awalan VITE_ dan hanya dibaca server di
# folder server/.
# ==============================================================================

# URL Project Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon / Publishable Key (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alamat backend asisten AI. Opsional, bawaan: http://localhost:8787
VITE_ASSISTANT_API_URL=http://localhost:8787

# ------------------------------------------------------------------------------
# BACKEND ASISTEN AI (folder server/, dijalankan dengan `npm run server`)
# ------------------------------------------------------------------------------

# Port server asisten. Opsional, bawaan: 8787
PORT=8787

# Supabase untuk backend. Jika dikosongkan, backend memakai VITE_SUPABASE_URL dan
# VITE_SUPABASE_ANON_KEY di atas (keduanya memang nilai publik).
# Backend memakai token sesi pengguna + anon key, jadi SERVICE ROLE KEY TIDAK DIBUTUHKAN.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Penyedia model AI. Kosongkan AI_PROVIDER_API_KEY untuk menjalankan asisten dalam
# mode "perhitungan aplikasi": jawaban tetap dihitung FinTrack, tanpa memanggil model.
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Origin frontend yang boleh memanggil backend. Opsional, bawaan: http://localhost:5173
AI_ALLOWED_ORIGIN=http://localhost:5173

# Batas panjang input, frekuensi request, dan biaya (opsional, nilai di bawah = bawaan)
AI_MAX_QUESTION_LENGTH=500
AI_RATE_LIMIT_MAX=15
AI_RATE_LIMIT_WINDOW_MS=600000
AI_MAX_TOKENS=700
AI_TIMEOUT_MS=30000
AI_DATA_MONTHS_BACK=3
AI_DATA_ROW_LIMIT=2000
